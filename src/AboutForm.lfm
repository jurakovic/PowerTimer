object frmAbout: TfrmAbout
  Left = 400
  Height = 154
  Top = 300
  Width = 420
  AutoSize = True
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Caption = 'About Power Timer'
  ChildSizing.LeftRightSpacing = 16
  ChildSizing.TopBottomSpacing = 16
  ClientHeight = 154
  ClientWidth = 420
  DesignTimePPI = 96
  Font.Height = -12
  Font.Name = 'Segoe UI'
  Position = poOwnerFormCenter
  OnCreate = FormCreate
  LCLVersion = '4.8.0.0'
  object imgIcon: TImage
    Left = 16
    Height = 32
    Top = 16
    Width = 32
    Proportional = True
    Stretch = True
  end
  object lblTitle: TLabel
    AnchorSideLeft.Control = imgIcon
    AnchorSideLeft.Side = asrBottom
    AnchorSideTop.Control = imgIcon
    Left = 64
    Height = 17
    Top = 16
    Width = 84
    BorderSpacing.Left = 16
    Caption = 'Power Timer'
    Font.Height = -14
    Font.Name = 'Segoe UI'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblDescription: TLabel
    AnchorSideLeft.Control = lblTitle
    AnchorSideTop.Control = lblTitle
    AnchorSideTop.Side = asrBottom
    Left = 64
    Height = 28
    Top = 43
    Width = 340
    BorderSpacing.Top = 8
    Caption = 'Shuts down, restarts, logs off, locks, suspends or hibernates'#13#10'the computer after a countdown or at a set time.'
  end
  object lblLink: TLabel
    Cursor = crHandPoint
    AnchorSideLeft.Control = lblTitle
    AnchorSideTop.Control = lblDescription
    AnchorSideTop.Side = asrBottom
    Left = 64
    Height = 14
    Top = 79
    Width = 240
    BorderSpacing.Top = 8
    Caption = 'https://github.com/jurakovic/PowerTimer'
    Font.Color = clHotLight
    Font.Height = -12
    Font.Name = 'Segoe UI'
    Font.Style = [fsUnderline]
    ParentFont = False
    OnClick = lblLinkClick
  end
  object btnOK: TButton
    AnchorSideTop.Control = lblLink
    AnchorSideTop.Side = asrBottom
    AnchorSideRight.Control = lblDescription
    AnchorSideRight.Side = asrBottom
    Left = 329
    Height = 25
    Top = 109
    Width = 75
    Anchors = [akTop, akRight]
    BorderSpacing.Top = 16
    Cancel = True
    Caption = 'OK'
    Default = True
    ModalResult = 1
    TabOrder = 0
  end
end
